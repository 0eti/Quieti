<UserControl x:Class="EarTrumpet.Quieti.QuietiMuteGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
             xmlns:local="clr-namespace:EarTrumpet.Quieti"
             IsHitTestVisible="False"
             IsTabStop="False">
    <!-- The moon that stands in for the speaker of the mute glyph (E74F) while Quieti has muted the app. The X is
         the mute glyph itself with its speaker masked out (see AppItemView), so it never moves between the two
         mute states. The canvas is the glyph's em square (Segoe MDL2 Assets: advance 1 em, line spacing 1 em),
         so a control of the glyph's font size lines up with it. The moon keeps the old Quieti icon's proportions
         (bite radius 9.5/14, offset 7/14 of the disc radius, level) and stays left of the X (x >= 50.9). -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <!-- Centered: the crescent spans x 1..42.2 (tips where the two circles meet), so moving it by 28 puts
                 its middle on the em square's middle. -->
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Centered, RelativeSource={RelativeSource AncestorType=local:QuietiMuteGlyph}}" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="28" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Path Theme:Brush.Fill="{Binding FillTheme, RelativeSource={RelativeSource AncestorType=local:QuietiMuteGlyph}}">
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <EllipseGeometry Center="24,50" RadiusX="23" RadiusY="23" />
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <EllipseGeometry Center="35.5,50" RadiusX="15.6" RadiusY="15.6" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
