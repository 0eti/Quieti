<UserControl x:Class="EarTrumpet.Quieti.CrescentBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
             xmlns:local="clr-namespace:EarTrumpet.Quieti"
             IsHitTestVisible="False"
             IsTabStop="False">
    <!-- The Quieti moon, same proportions as the old Quieti icon (disc 16,16 r14; bite 23,16 r9.5 on a 32 grid):
         a circle with a level bite taken out of its right side. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <Path Theme:Brush.Fill="{Binding FillTheme, RelativeSource={RelativeSource AncestorType=local:CrescentBadge}}">
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <EllipseGeometry Center="75,50" RadiusX="34" RadiusY="34" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
