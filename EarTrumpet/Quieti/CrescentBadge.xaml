<UserControl x:Class="EarTrumpet.Quieti.CrescentBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
             xmlns:local="clr-namespace:EarTrumpet.Quieti"
             IsHitTestVisible="False"
             IsTabStop="False">
    <!-- A circle with a crescent bite taken out of its right side (the Quieti moon). -->
    <Viewbox Stretch="Uniform">
        <Path Width="100"
              Height="100"
              Theme:Brush.Fill="{Binding FillTheme, RelativeSource={RelativeSource AncestorType=local:CrescentBadge}}"
              Stretch="Fill">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <EllipseGeometry Center="78,36" RadiusX="38" RadiusY="38" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>
    </Viewbox>
</UserControl>
