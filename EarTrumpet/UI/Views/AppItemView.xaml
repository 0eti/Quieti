<UserControl x:Class="EarTrumpet.UI.Views.AppItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
             xmlns:ctl="clr-namespace:EarTrumpet.UI.Controls"
             xmlns:conv="clr-namespace:EarTrumpet.UI.Converters"
             xmlns:quieti="clr-namespace:EarTrumpet.Quieti"
             Height="{DynamicResource Mutable_AppItemCellHeight}"
             IsTabStop="False">
    <UserControl.Resources>
        <conv:VolumeToStringConverter x:Key="VolumeToStringConverter"/>
    </UserControl.Resources>
    <Grid Name="GridRoot" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{DynamicResource Mutable_IconCellWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{DynamicResource Mutable_VolumeCellWidth}" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="{StaticResource DeviceOrAppIconMargin}">
            <Border Width="{DynamicResource Mutable_AppIconSize}"
                    Height="{DynamicResource Mutable_AppIconSize}"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="true">
                                <Setter Property="Opacity" Value="{StaticResource MutedOpacity}" />
                            </DataTrigger>
                            <!-- Quieti: armed but still audible (in front) shows a moon over the icon, dimmed like a mute. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBackgroundMuteArmed}" Value="True" />
                                    <Condition Binding="{Binding IsMuted}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="{StaticResource MutedOpacity}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Source, ElementName=AppIcon}" Value="{x:Null}">
                                <Setter Property="Theme:Brush.Background" Value="SystemAccent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ctl:ImageEx x:Name="AppIcon"
                                 Width="{DynamicResource Mutable_AppIconSize}"
                                 Height="{DynamicResource Mutable_AppIconSize}"
                                 SourceEx="{Binding}"
                                 Stretch="Fill" />
                    <Border>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=AppIcon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Margin="0,-1,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Theme:Brush.Foreground="Text"
                                   FontSize="{DynamicResource Mutable_AppIconTextFontSize}"
                                   FontWeight="SemiBold"
                                   Text="{Binding IconText}"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <Button Name="MuteButton"
                    Width="{DynamicResource Mutable_AppIconSize}"
                    Height="{DynamicResource Mutable_AppIconSize}"
                    Command="{Binding ToggleBackgroundMute}"
                    IsTabStop="False"
                    ToolTip="{Binding MuteButtonToolTip}">
                <Button.Style>
                    <Style BasedOn="{StaticResource MuteButton}" TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="true">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsBackgroundMuteArmed}" Value="True" />
                                    <Condition Binding="{Binding IsMuted}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Content>
                    <Grid>
                        <TextBlock Theme:Brush.Foreground="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontSize="{DynamicResource Mutable_DeviceVolumeTextFontSize}"
                                   Opacity="0.8"
                                   Text="&#xE74F;">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource GlyphTextBlockStyle}" TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- Quieti: keep this glyph's X but hide its speaker (left 45% of the em square;
                                             speaker ends at 37.5%, X starts at 50.9%). QuietiMuteGlyph draws the moon
                                             there, so the X is the very same text in both mute states. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBackgroundMuteArmed}" Value="True" />
                                                <Condition Binding="{Binding IsMuted}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsMutedByQuieti}" Value="True">
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0.45" Color="Transparent" />
                                                        <GradientStop Offset="0.45" Color="Black" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <quieti:QuietiMuteGlyph Width="{DynamicResource Mutable_DeviceVolumeTextFontSize}"
                                                Height="{DynamicResource Mutable_DeviceVolumeTextFontSize}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FillTheme="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}"
                                                Opacity="0.8">
                            <quieti:QuietiMuteGlyph.Style>
                                <Style TargetType="quieti:QuietiMuteGlyph">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMutedByQuieti}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </quieti:QuietiMuteGlyph.Style>
                        </quieti:QuietiMuteGlyph>
                        <!-- Quieti: armed but still audible (in front): the moon alone, centered. -->
                        <quieti:QuietiMuteGlyph Width="{DynamicResource Mutable_DeviceVolumeTextFontSize}"
                                                Height="{DynamicResource Mutable_DeviceVolumeTextFontSize}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Centered="True"
                                                FillTheme="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}"
                                                Opacity="0.8">
                            <quieti:QuietiMuteGlyph.Style>
                                <Style TargetType="quieti:QuietiMuteGlyph">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsBackgroundMuteArmed}" Value="True" />
                                                <Condition Binding="{Binding IsMuted}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </quieti:QuietiMuteGlyph.Style>
                        </quieti:QuietiMuteGlyph>
                    </Grid>
                </Button.Content>
            </Button>
            <!-- Quieti badge: 40% of the icon, bottom right, only while "mute while in background" is armed. -->
            <Grid Width="{DynamicResource Mutable_AppIconSize}"
                  Height="{DynamicResource Mutable_AppIconSize}"
                  HorizontalAlignment="Center"
                  IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <quieti:CrescentBadge Grid.Row="1" Grid.Column="1">
                    <quieti:CrescentBadge.Style>
                        <Style TargetType="quieti:CrescentBadge">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBackgroundMuteArmed}" Value="True" />
                                        <Condition Binding="{Binding ShowBadge, Source={x:Static quieti:QuietiDisplay.Current}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </quieti:CrescentBadge.Style>
                </quieti:CrescentBadge>
            </Grid>
        </Grid>
        <ctl:VolumeSlider Grid.Column="1"
                          PeakValue1="{Binding PeakValue1}"
                          PeakValue2="{Binding PeakValue2}"
                          Value="{Binding Volume, Mode=TwoWay}">
            <ctl:VolumeSlider.Style>
                <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="Opacity" Value="{StaticResource MutedOpacity}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ctl:VolumeSlider.Style>
        </ctl:VolumeSlider>
        <TextBlock Grid.Column="2" Text="{Binding Volume, Mode=OneWay, Converter={StaticResource VolumeToStringConverter}}">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource AppVolumeTextStyle}" TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                            <Setter Property="Opacity" Value="{StaticResource MutedOpacity}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
